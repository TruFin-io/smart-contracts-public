{
  "name": "pol-staker",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "test": "npx hardhat test mocha",
    "lint": "npm run lint:sol && npm run lint:ts && npm run prettier:check",
    "lint:sol": "forge fmt --check && solhint \"{scripts,contracts}/**/*.sol\"",
    "lint:ts": "eslint --ignore-path ./.eslintignore --ext .js,.ts .",
    "prettier:write": "prettier --write \"**/*.{js,json,md,ts,yml}\"",
    "prettier:check": "prettier --check \"**/*.{js,json,md,ts,yml}\"",
    "coverage-sol": "npx hardhat --coverage test mocha",
    "forge-coverage:report": "./shell/coverage.sh",
    "check-gas": "forge snapshot --match-test '^test.*' && npx hardhat --gas-stats test mocha",
    "size-contracts": "npx hardhat contract-size list",
    "export-abis": "npx hardhat run scripts/export-abis.ts",
    "slither": "slither .",
    "clean": "npx hardhat clean"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@openzeppelin/hardhat-upgrades": "^4.1.0",
    "@solidstate/hardhat-contract-sizer": "^3.0.3",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "chai": "^5.1.2",
    "cli-color": "^2.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "ethers": "^6.14.0",
    "hardhat": "^3.12.0",
    "mocha": "^11.0.0",
    "prettier": "^3.2.4",
    "solhint": "^5.0.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ethersproject/constants": "^5.7.0",
    "@openzeppelin/contracts": "~5.4.0",
    "@openzeppelin/contracts-upgradeable": "~5.4.0",
    "dotenv": "^16.4.1",
    "envfile": "^7.1.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.6"
  },
  "overrides": {
    "cookie": "0.7.0",
    "qs": "6.15.3",
    "tmp": "0.2.7"
  }
}
